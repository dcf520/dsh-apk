+/// 插件胶囊的状态：报错优先于禁用，其余按运行中算。
+CapsuleStatus capsuleStatusOf(PluginBundle? bundle) {
+  if (bundle == null) return CapsuleStatus.running;
+  if (bundle.error != null) return CapsuleStatus.error;
+  return bundle.enabled ? CapsuleStatus.running : CapsuleStatus.disabled;
+}
+
+/// 悬停提示：名称、版本、说明；作者字段客户端没暴露，就不写。
+String capsuleTooltipOf(PluginBundle? bundle, String title) {
+  if (bundle == null) return title;
+  final parts = <String>[title];
+  final version = bundle.version;
+  if (version != null && version.isNotEmpty) parts.add('v$version');
+  final description = bundle.description?.trim();
+  if (description != null && description.isNotEmpty) parts.add(description);
+  return parts.join('\n');
+}
